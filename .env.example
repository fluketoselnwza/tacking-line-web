DATABASE_URL="postgresql://recipe:recipe@localhost:5432/recipe_dashboard?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"
VIEWER_EMAIL="viewer@example.com"
VIEWER_PASSWORD="replace-with-a-different-long-password"
# Integration tests ONLY: dedicated disposable database, never production
TEST_DATABASE_URL="postgresql://recipe:recipe@localhost:5432/recipe_dashboard_test?schema=public"

# Production canonical URL (set this when behind HTTPS reverse proxy)
